{
  "name": "explainroo",
  "version": "0.1.1",
  "description": "Narrated explainer videos made by your coding agent. Pure JavaScript, local voice, no API keys. Includes explainroo studio, a model-free front end for your own transcript, timings and voice-over.",
  "keywords": [
    "video",
    "explainer",
    "text-to-speech",
    "kokoro",
    "whisper",
    "animation",
    "canvas",
    "claude-code",
    "codex",
    "agents",
    "motion-graphics",
    "ffmpeg"
  ],
  "homepage": "https://github.com/vincentsch/explainroo#readme",
  "bugs": {
    "url": "https://github.com/vincentsch/explainroo/issues"
  },
  "type": "module",
  "bin": {
    "explainroo": "bin/explainroo.js"
  },
  "files": [
    "bin/",
    "src/",
    "engine/",
    "fonts/",
    "templates/",
    "skills/",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "LICENSE",
    "frontend/",
    "scripts/",
    "vite.config.ts",
    "tsconfig.json"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "license": "MIT",
  "author": "Vincent Schmalbach",
  "repository": "github:vincentsch/explainroo",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.js",
    "test:studio": "node frontend/server/selftest.mjs",
    "test:ui": "node frontend/server/uitest.mjs",
    "lint:html": "node frontend/scripts/check-doctype.mjs && node frontend/scripts/check-charset.mjs && node frontend/scripts/check-viewport.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build:fonts": "node scripts/fetch-fonts.mjs",
    "skills:install": "node scripts/install-agent-skills.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "kokoro-js": "1.2.1",
    "playwright-core": "1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "roughjs": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "lucide-static": "1.48.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
